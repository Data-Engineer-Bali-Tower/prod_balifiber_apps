    <connection>dwh.balitower.co.id</connection>
    <sql>select
	to_char(lastrun,'yyyy-mm-dd')lastrun,
	to_char(current_timestamp,'yyyy-mm-dd') as currentdate,
	to_char(current_timestamp,'dd Mon yyyy HH24:MI:SS')datetext
from
	etl.etlstatus
where
	etlname = 'balifiber_prod'</sql>
